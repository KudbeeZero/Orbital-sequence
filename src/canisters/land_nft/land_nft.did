// Candid interface for the LandNFT ICRC-7 canister

type Biome = variant {
  Forest;
  Desert;
  Mountain;
  Plains;
  Water;
  Tundra;
  Volcanic;
  Swamp;
};

type PlotMetadata = record {
  tokenId      : nat;
  biome        : Biome;
  lat          : int;
  lon          : int;
  ironYield    : nat;
  fuelYield    : nat;
  crystalYield : nat;
};

type TransferArgs = record {
  from    : principal;
  to      : principal;
  tokenId : nat;
};

type TransferResult = variant {
  Ok  : nat;
  Err : text;
};

service : {
  // Admin
  init_plots     : ()                              -> (text);
  purchase_plot  : (nat, principal)               -> (TransferResult);

  // ICRC-7
  icrc7_owner_of      : (nat)       -> (opt principal) query;
  icrc7_balance_of    : (principal) -> (nat)            query;
  icrc7_transfer      : (TransferArgs)             -> (TransferResult);
  icrc7_token_metadata: (nat)       -> (opt PlotMetadata) query;
  icrc7_total_supply  : ()          -> (nat)            query;
  icrc7_name          : ()          -> (text)           query;
  icrc7_symbol        : ()          -> (text)           query;

  // Helpers
  get_tokens_of  : (principal)      -> (vec nat)        query;
  get_plots_range: (nat, nat)        -> (vec PlotMetadata) query;
}
