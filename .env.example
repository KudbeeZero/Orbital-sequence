# ICP network: 'local' for local replica, 'ic' for mainnet
DFX_NETWORK=local

# Canister IDs — populated automatically by 'dfx deploy' via .env.dfx
# Or set manually for mainnet:
CANISTER_ID_LAND_NFT=
CANISTER_ID_FRONTIER_TOKEN=
CANISTER_ID_GAME_STATE=
CANISTER_ID_INTERNET_IDENTITY=

# Local Internet Identity URL (auto-set by dfx on local network)
# Mainnet II is always: https://identity.ic0.app
